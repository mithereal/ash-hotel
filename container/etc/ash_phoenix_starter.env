PHX_SERVER=true
PHX_HOST=yourdomain.com
PORT=4000

# Erlang Clustering (must match across all VMs; set RELEASE_NODE per regional VM)
RELEASE_DISTRIBUTION=name
RELEASE_NODE=app_us_ashburn_1@10.0.1.10
RELEASE_COOKIE=replace_with_a_long_random_secret_cookie
CLUSTER_NODES=app_us_ashburn_1@10.0.1.10,app_eu_frankfurt_1@10.0.2.10

# Database & Secrets
DATABASE_URL=ecto://user:pass@db-host:5432/ash_phoenix_starter_prod
SECRET_KEY_BASE=replace_with_mix_phx_gen_secret
TOKEN_SIGNING_SECRET=replace_with_random_secret

# OCI Object Storage (S3-Compatible)
DEFAULT_STORAGE_PROVIDER=oci
OCI_REGION=us-ashburn-1
OCI_STORAGE_HOST=your_://oraclecloud.com
DEFAULT_BUCKET=hotel-media-prod
STORAGE_ACCESS_KEY=your_oci_customer_secret_key_id
STORAGE_SECRET_KEY=your_oci_customer_secret_key
STORAGE_CDN_URL=https://yourdomain.com

# Stripe Metered Billing
STRIPE_SECRET_KEY=sk_live_...
INTERNAL_WORKER_SECRET=<long_random_secret>
